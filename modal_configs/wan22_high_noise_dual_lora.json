{
  "_comment": "WAN 2.2 HIGH-NOISE LoRA Training (timesteps 875-1000)",
  "_tutorial": "Dual LoRA training - Train HIGH and LOW separately, use both together",

  "task": "t2v-A14B",
  "dit_path": "wan/wan2.2_t2v_high_noise_14B_fp16.safetensors",
