{
  "_comment": "WAN 2.2 Single LoRA Training - Vankoala Tutorial Style",
  "_tutorial": "Based on Vankoala's guide - single low-noise LoRA with longer training",

  "task": "t2v-14B",
  "dit_path": "wan/wan2.2_t2v_low_noise_14B_fp16.safetensors",
  "vae_path": "wan/wan_2.1_vae.safetensors",
  "t5_path": "wan/models_t5_umt5-xxl-enc-bf16.pth",

  "dataset_config": "wan_dataset/config.toml",
  "output_name": "my_character_vankoala",

  "network_dim": 32,
